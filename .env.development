# Local development: Firebase emulators only (npm run dev).
# The "demo-" project id prefix makes Firebase refuse to reach any real cloud project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-scoreboard.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-scoreboard
VITE_FIREBASE_STORAGE_BUCKET=demo-scoreboard.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
